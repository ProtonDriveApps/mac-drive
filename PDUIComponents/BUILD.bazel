load("@rules_swift//swift:swift.bzl", "swift_library")
load("@rules_apple//apple:resources.bzl", "apple_resource_bundle")
load("@rules_swift_package_manager//swiftpkg:build_defs.bzl", "resource_bundle_infoplist")

package(default_visibility = ["//visibility:public"])

swift_library(
    name = "PDUIComponents",
    module_name = "PDUIComponents",
    srcs = glob(["PDUIComponents/**/*.swift"]) + ["//build_defs:PDUIComponentsBundle.swift"],
    deps = [
        "//PDLocalization",
        "@swiftpkg_protoncore_ios//:ProtonCoreUIFoundations",
    ],
    data = [":PDUIComponentsResources"],
)

resource_bundle_infoplist(
    name = "resource_info",
    region = "en",
)

apple_resource_bundle(
    name = "PDUIComponentsResources",
    bundle_name = "PDUIComponents_PDUIComponents",
    infoplists = [":resource_info"],
    resources = glob(["PDUIComponents/Media.xcassets/**"]),
)
