common --enable_bzlmod
common --experimental_isolated_extension_usages
common --repo_contents_cache=
build --nostamp
build --repo_env=DEVELOPER_DIR
build --guard_against_concurrent_changes
build --action_env=PYTHONDONTWRITEBYTECODE=1
build --host_action_env=PYTHONDONTWRITEBYTECODE=1
build --action_env=PATH=/usr/bin:/bin:/usr/sbin:/sbin
build --host_action_env=PATH=/usr/bin:/bin:/usr/sbin:/sbin
build --worker_sandboxing
build --nosandbox_default_allow_network
build --action_env=IBToolNeverDeque=1
build --host_action_env=IBToolNeverDeque=1
build --modify_execution_info=^(AssetCatalogCompile|StoryboardCompile|StoryboardLink|XibCompile)$=-no-sandbox
build --strategy=AssetCatalogCompile=darwin-sandbox
build --strategy=StoryboardCompile=darwin-sandbox
build --strategy=StoryboardLink=darwin-sandbox
build --strategy=XibCompile=darwin-sandbox
build --modify_execution_info=ProcessAndSign=-no-sandbox
build --strategy=ProcessAndSign=darwin-sandbox
build --modify_execution_info=ImportedDynamicFrameworkProcessor=-no-sandbox
build --strategy=ImportedDynamicFrameworkProcessor=darwin-sandbox
build --compilation_mode=opt
build --macos_cpus=arm64,x86_64
build --objc_enable_binary_stripping
build --apple_generate_dsym
build --@rules_apple//apple/build_settings:signing_certificate_name=-
