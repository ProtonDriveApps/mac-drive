<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>APP_VERSION_IDENTIFIER</key>
	<string>$(APP_VERSION_IDENTIFIER)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>ProtonDriveFileProvider</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>Debug</string>
	<key>DEFAULT_API_HOST</key>
	<string>$(DEFAULT_API_HOST)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSExtension</key>
	<dict>
		<key>NSFileProviderUserInteractions</key>
		<array>
			<dict>
				<key>ActivationRule</key>
				<string>action == &quot;Rename&quot; AND ((NOT sourceItem.filename ENDSWITH[cd] &quot;.protondoc&quot; AND destinationItem.filename ENDSWITH[cd] &quot;.protondoc&quot;) OR (NOT sourceItem.filename ENDSWITH[cd] &quot;.protonsheet&quot; AND destinationItem.filename ENDSWITH[cd] &quot;.protonsheet&quot;))</string>
				<key>Alert</key>
				<dict>
					<key>RecoveryOptions</key>
					<dict>
						<key>Continue</key>
						<false/>
					</dict>
					<key>LocalizedTitle</key>
					<string>File cannot be converted to cloud-only Proton file</string>
					<key>LocalizedSubTitle</key>
					<string>Cloud-only Proton files must be created on the Web.</string>
				</dict>
			</dict>
			<dict>
				<key>ActivationRule</key>
				<string>(action == &quot;Create&quot; OR action == &quot;MoveIn&quot; OR action == &quot;CopyIn&quot; OR action == &quot;Copy&quot;) AND (sourceItem.filename ENDSWITH[cd] &quot;.protondoc&quot; OR sourceItem.filename ENDSWITH[cd] &quot;.protonsheet&quot;)</string>
				<key>Alert</key>
				<dict>
					<key>RecoveryOptions</key>
					<dict>
						<key>Continue</key>
						<false/>
					</dict>
					<key>LocalizedTitle</key>
					<string>Cloud-only Proton file cannot be created</string>
					<key>LocalizedSubTitle</key>
					<string>This file is cloud-only. Cloud-only Proton files can only be created, copied or duplicated on the Web.</string>
				</dict>
			</dict>
			<dict>
				<key>ActivationRule</key>
				<string>action == &quot;MoveOut&quot; AND (sourceItem.filename ENDSWITH[cd] &quot;.protondoc&quot; OR sourceItem.filename ENDSWITH[cd] &quot;.protonsheet&quot;)</string>
				<key>Alert</key>
				<dict>
					<key>RecoveryOptions</key>
					<dict>
						<key>Continue</key>
						<false/>
					</dict>
					<key>LocalizedTitle</key>
					<string>Cloud-only Proton file cannot be moved here</string>
					<key>LocalizedSubTitle</key>
					<string>Moving a cloud-only Proton file outside Proton Drive would prevent it from opening.</string>
				</dict>
			</dict>
			<dict>
				<key>ActivationRule</key>
				<string>action == &quot;Rename&quot; AND ((sourceItem.filename ENDSWITH[cd] &quot;.protondoc&quot; AND NOT destinationItem.filename ENDSWITH[cd] &quot;.protondoc&quot;) OR (sourceItem.filename ENDSWITH[cd] &quot;.protonsheet&quot; AND NOT destinationItem.filename ENDSWITH[cd] &quot;.protonsheet&quot;))</string>
				<key>Alert</key>
				<dict>
					<key>RecoveryOptions</key>
					<dict>
						<key>Continue</key>
						<false/>
					</dict>
					<key>LocalizedTitle</key>
					<string>Cloud-only Proton file extension cannot be changed</string>
					<key>LocalizedSubTitle</key>
					<string>Changing a cloud-only Proton file extension would prevent it from opening.</string>
				</dict>
			</dict>
		</array>
		<key>NSExtensionAttributes</key>
		<dict/>
		<key>NSExtensionFileProviderActions</key>
		<array>
			<dict>
				<key>NSExtensionFileProviderActionActivationRule</key>
				<string>SUBQUERY ( fileproviderItems, $item, $item.itemIdentifier != &quot;NSFileProviderRootContainerItemIdentifier&quot; &amp;&amp; $item.userInfo.keep_downloaded != YES &amp;&amp; $item.userInfo.inherit_keep_downloaded != YES ).@count &gt; 0</string>
				<key>NSExtensionFileProviderActionIdentifier</key>
				<string>ch.protonmail.drive.fileprovider.action.keep_downloaded</string>
				<key>NSExtensionFileProviderActionName</key>
				<string>Make Available Offline</string>
			</dict>
			<dict>
				<key>NSExtensionFileProviderActionActivationRule</key>
				<string>SUBQUERY ( fileproviderItems, $item, ($item.itemIdentifier != &quot;NSFileProviderRootContainerItemIdentifier&quot; &amp;&amp; $item.isUploaded == YES &amp;&amp; ($item.isDownloaded == YES || $item.isDownloading == YES) ) ).@count &gt; 0</string>
				<key>NSExtensionFileProviderActionIdentifier</key>
				<string>ch.protonmail.drive.fileprovider.action.remove_download</string>
				<key>NSExtensionFileProviderActionName</key>
				<string>Online Only (Free Up Space)</string>
			</dict>
			<dict>
				<key>NSExtensionFileProviderActionActivationRule</key>
				<string>SUBQUERY ( fileproviderItems, $item, ($item.itemIdentifier != &quot;NSFileProviderRootContainerItemIdentifier&quot; ) ).@count &gt; 0</string>
				<key>NSExtensionFileProviderActionIdentifier</key>
				<string>ch.protonmail.drive.fileprovider.action.open_in_browser</string>
				<key>NSExtensionFileProviderActionName</key>
				<string>View Online</string>
			</dict>
			<dict>
				<key>NSExtensionFileProviderActionActivationRule</key>
				<string>TRUEPREDICATE</string>
				<key>NSExtensionFileProviderActionIdentifier</key>
				<string>ch.protonmail.drive.fileprovider.action.refresh</string>
				<key>NSExtensionFileProviderActionName</key>
				<string>Refresh</string>
			</dict>
		</array>
		<key>NSExtensionFileProviderAllowsContextualMenuDownloadEntry</key>
		<false/>
		<key>NSExtensionFileProviderAllowsUserControlledEviction</key>
		<false/>
		<key>NSExtensionFileProviderDocumentGroup</key>
		<string>$(TeamIdentifierPrefix)ch.protonmail.protondrive</string>
		<key>NSExtensionFileProviderDownloadPipelineDepth</key>
		<integer>8</integer>
		<key>NSExtensionFileProviderSupportsEnumeration</key>
		<true/>
		<key>NSExtensionFileProviderUploadPipelineDepth</key>
		<integer>8</integer>
		<key>NSExtensionFileProviderWantsFlattenedPackages</key>
		<true/>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.fileprovider-nonui</string>
		<key>NSExtensionPrincipalClass</key>
		<string>$(PRODUCT_MODULE_NAME).FileProviderExtension</string>
		<key>NSFileProviderDecorations</key>
		<array>
			<dict>
				<key>BadgeImageType</key>
				<string>me.proton.drive.badge.checkmark</string>
				<key>Category</key>
				<string>Badge</string>
				<key>Identifier</key>
				<string>me.proton.drive.fileproviderdecorations.badge.checkmark</string>
				<key>Label</key>
				<string>Available offline</string>
			</dict>
			<dict>
				<key>BadgeImageType</key>
				<string>me.proton.drive.fileBadge.shared</string>
				<key>Category</key>
				<string>Sharing</string>
				<key>Identifier</key>
				<string>me.proton.drive.fileproviderdecorations.shared.file</string>
				<key>Label</key>
				<string>Shared</string>
			</dict>
			<dict>
				<key>BadgeImageType</key>
				<string></string>
				<key>Category</key>
				<string>Sharing</string>
				<key>Identifier</key>
				<string>me.proton.drive.fileproviderdecorations.shared.label</string>
				<key>Label</key>
				<string>Shared</string>
			</dict>
			<dict>
				<key>BadgeImageType</key>
				<string>me.proton.drive.folderBadge.shared</string>
				<key>Category</key>
				<string>FolderBadge</string>
				<key>Identifier</key>
				<string>me.proton.drive.fileproviderdecorations.shared.folderBadge</string>
				<key>Label</key>
				<string></string>
			</dict>
		</array>
	</dict>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
</dict>
</plist>
